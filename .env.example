# Copy this file to .env
# .env is git-ignored; this template is committed.
#
# Koneksi database diatur langsung di app.py:
#     app.config["SQLALCHEMY_DATABASE_URI"] = "postgresql://user:password@host:port/dbname"
# Sesuaikan baris tersebut dengan user dan password PostgreSQL milik sendiri.

FLASK_APP=app.py
FLASK_DEBUG=1
