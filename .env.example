# Copy this file to .env and fill in your own values.
# .env is git-ignored; this template is committed.

# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/revoshop_db

# Separate database used by the pytest suite -- never point this at real data.
TEST_DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/revoshop_test_db

# Signs session cookies and JWT access tokens. Use a long random value in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

FLASK_APP=app.py

# Set to 0 before a load test -- debug mode changes error handling and adds overhead.
FLASK_DEBUG=1

# SQLAlchemy connection pool, applied per process.
# Total connections = processes x (DB_POOL_SIZE + DB_MAX_OVERFLOW), and must stay
# under the Postgres max_connections setting (100 by default).
# These defaults suit the gunicorn deploy shape: 3 workers x (5 + 5) = 30.
# For a local waitress load test at 32 threads, override with 30 / 10 (see README section 7).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
